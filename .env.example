# Nue Configuration
# Copy this file to .env and fill in your actual values.
# Variable names follow the tap's setting keys; run `tap-nue --about` for the
# authoritative list.

# Required: API key used to authenticate against Nue
TAP_NUE_API_KEY=your_api_key_here

# Optional: The earliest record date to sync (ISO-8601)
TAP_NUE_START_DATE=2023-01-01T00:00:00Z

# Optional: API base URL (defaults to https://api.sandbox.nue.io)
TAP_NUE_BASE_URL=https://api.sandbox.nue.io
